@@ -10,6 +10,24 @@ import "fmt"
 
 // Invoice is a bill for one customer account.
 type Invoice struct {
+	Lines []Line
+	Note  string
+}
+
+// Line is one charge on an invoice.
+type Line struct {
+	Item   string
+	Cents  int64
+	Amount int
+}
+
+// Total returns the invoice total in cents.
+func (inv Invoice) Total() int64 {
+	var sum int64
+	for _, l := range inv.Lines {
+		sum += l.Cents * int64(l.Amount)
+	}
+	return sum
 }
 
 func (inv Invoice) String() string {
